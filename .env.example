# Acronis API credentials
ACRONIS_BASE_URL=https://your-datacenter.acronis.com
ACRONIS_CLIENT_ID=your-acronis-client-id
ACRONIS_CLIENT_SECRET=your-acronis-client-secret

# Zoho Desk credentials
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ORG_ID=your-zoho-org-id
ZOHO_ORG_SLUG=your-org-slug
ZOHO_DEPARTMENT_ID=your-department-id
ZOHO_DEPARTMENT_SLUG=your-department-slug
ZOHO_BASE_URL=https://desk.zoho.com

# Google Sheets (for client → Zoho account mapping)
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Database (set to /data/backup-alerts.db on Render with a Disk)
DATABASE_PATH=./data/backup-alerts.db

# Server
PORT=10000
NODE_ENV=development
